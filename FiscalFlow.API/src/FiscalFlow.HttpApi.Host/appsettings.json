{
  "App": {
    "SelfUrl": "https://localhost:44392",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=FiscalFlow;User ID=root;Password=myPassword;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44392",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "FiscalFlow_Swagger",
    "CertificatePassPhrase": "60fd3244-83a8-48dc-a9f2-8e958ca2ce6b"
  },
  "StringEncryption": {
